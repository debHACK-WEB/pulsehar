{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "PulseHAR Sample Generator",
      "version": "0.1.0"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "http://api.example.com/v1/user?token=DUMMY_SAMPLE_TOKEN_12345",
          "headers": [
            { "name": "Host", "value": "api.example.com" },
            { "name": "Authorization", "value": "Bearer DUMMY_SAMPLE_TOKEN_12345" }
          ]
        },
        "response": {
          "status": 200,
          "headers": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Set-Cookie", "value": "session_id=abc123xyz; Path=/; HttpOnly" }
          ],
          "content": {
            "mimeType": "application/json",
            "text": "{\"status\":\"ok\"}"
          }
        }
      }
    ]
  }
}
